color-link default "#CCCCCC,#000000"
color-link comment "#707070,#000000"
color-link identifier "#FFC66D,#000000"
color-link constant "#7A9EC2,#000000"
color-link constant.string "#6A8759,#000000"
color-link constant.string.char "#6A8759,#000000"
color-link statement "#CC8242,#000000"
