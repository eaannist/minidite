color-link preproc "#CC8242,#000000"
color-link type "#CC8242,#000000"
color-link special "#CC8242,#000000"
color-link underlined "#D33682,#000000"
color-link error "bold #CB4B16,#000000"
color-link todo "bold #D33682,#000000"
color-link hlsearch "#CCCCCC,#32593D"
color-link statusline "#CCCCCC,#20388A"
color-link tabbar "#000000,#CCCCCC"
color-link indent-char "#4F4F4F,#000000"
color-link line-number "#B3B3B3,#212121"
color-link current-line-number "#E8D98E,#0000000"
color-link diff-added "#00AF00"
color-link diff-modified "#FFAF00"
color-link diff-deleted "#D70000"
color-link gutter-error "#CB4B16,#000000"
color-link gutter-warning "#E6DB74,#000000"
