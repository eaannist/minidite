{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/minidite.txt",
    "color": {
      "1": "green",
      "2": "red"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{6}{7}{8}",
      "keyColor": "green"
    },
    "break",
    {
      "type": "host",
      "key": "+ PC",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "- cpu: ",
      "showPeCoreCount": true,
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "- gpu: ",
      "detectionMethod": "pci",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "- display: ",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "- disk: ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "- memory: ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "command",
      "key": "+ OS",
      "keyColor": "yellow",
      "text": "cat \"${HOME}/minidite-version\" 2>/dev/null | sed 's/^/v/' || echo 'vN/A'"
    },
    {
      "type": "command",
      "key": "- distro: ",
      "keyColor": "yellow",
      "text": "uname -r"
    },
    {
      "type": "kernel",
      "key": "- kernel: ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "- wm: ",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "+ DE",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "- terminal: ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "- packages: ",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "- wmtheme: ",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "- author: ",
      "keyColor": "yellow",
      "text": "echo 'eaannist'"
    },
    "break",
    {
      "type": "command",
      "key": "- age: ",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W / 2>/dev/null); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo ${days_difference:-0} days"
    },
    {
      "type": "uptime",
      "key": "- uptime: ",
      "keyColor": "blue"
    },
    "break"
  ]
}