{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/minidite.txt",
    "color": {
      "1": "green",
      "2": "red"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{6}{7}{8}",
      "keyColor": "green"
    },
    "break",
    {
      "type": "host",
      "key": " PC",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "showPeCoreCount": true,
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "├ ",
      "detectionMethod": "pci",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "├ ",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "├ ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "├ ",
      "keyColor": "red"
    },
    {
      "type": "swap",
      "key": "└ ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "command",
      "key": " OS",
      "keyColor": "yellow",
      "text": "cat ~/minidite-version 2>/dev/null || echo 'minidite'"
    },
    {
      "type": "command",
      "key": "├ ",
      "keyColor": "yellow",
      "text": "uname -r"
    },
    {
      "type": "kernel",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "wmtheme",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "├ ",
      "keyColor": "yellow",
      "text": "echo 'minidite'"
    },
    {
      "type": "terminalfont",
      "key": "└ ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "command",
      "key": " OS Age",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W / 2>/dev/null); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo ${days_difference:-0} days"
    },
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "blue"
    },
    "break"
  ]
}