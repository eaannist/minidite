{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
        {
          "background": "#0A4632",
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,background>\uE0B0</>",
          "trailing_diamond": "\uE0B0",
          "options": {
            "style": "full"
          },
          "style": "diamond",
          "template": " {{ .Env.TPath }} ",
          "type": "path"
        },
        {
          "type": "python",
          "style": "diamond",
          "background": "#306998",
          "foreground": "#ffd43b",
          "leading_diamond": "<transparent,background>\uE0B0</>",
          "trailing_diamond": "\uE0B0",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "fetch_version": false
          },
          "template": " \uE235 {{ .Venv }} "
        },
        {
          "background": "#3AD900",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFC600{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "foreground": "#000000",
          "leading_diamond": "<transparent,background>\uE0B0</>",
          "trailing_diamond": "\uE0B0",
          "options": {
            "fetch_status": true
          },
          "style": "diamond",
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}<#FF6F00> \uF046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uF044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \uEB4B {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}